# Copy to .env (gitignored) and fill in what you have.
#
# This file is the single source of configuration. Docker Compose reads it automatically
# from the repository root, and every setting the app has is passed through from here —
# there is no other config file to edit.
#
# NOTHING here is required to boot. The mock model routes and local Ollama models need no
# keys at all, so a clean checkout comes up and passes preflight with this file empty.

# --- The gateway --------------------------------------------------------------
# The one OpenAI-compatible endpoint every compute engine talks to. Leave both commented
# out to use the bundled LiteLLM container.
#
# To use a gateway you already have, set the URL and token here, then start with the
# external-gateway overlay so the bundled container is skipped:
#
#   docker compose -f compose.yaml -f compose.external-gateway.yaml up --build
#
# The URL must include the /v1 suffix. From inside Docker, a gateway running on the host
# machine is reachable as host.docker.internal, not localhost.
#
# GATEWAY_BASE_URL=https://litellm.your-company.com/v1
# GATEWAY_BASE_URL=http://host.docker.internal:4000/v1

# The backend's only credential. With the bundled gateway it is any string, as long as it
# matches on both sides. With your own gateway it is that gateway's key.
GATEWAY_API_KEY=sk-local

# --- Models -------------------------------------------------------------------
# All three take gateway ALIASES, never provider-native model strings. The submit form
# lists whatever your gateway returns from /v1/models, so these only set the defaults —
# and the defaults below exist on the bundled gateway, not on yours.

# Pre-selected subject model in the submit form. Deliberately local: the form must not
# default to a paid model, or a mis-click starts a billed run.
DEFAULT_SUBJECT_MODEL=gemma4

# Grader for the judged benchmarks. LOCAL BY DEFAULT so development and the end-to-end
# suite cost nothing. qwen35 runs on host Ollama and has proven adequate for the self-test
# evals.
#
# Switch to a hosted judge only for real calibration runs:
#   gpt-5.6-luna          $0.20/$1.20 per M tokens (needs OpenAI credits)
#   gemini-3.5-flash-lite $0.30/$2.50 per M tokens
#
# A run records which judge graded it, so a locally-judged or mock-judged run can never be
# mistaken for a calibrated evaluation.
DEFAULT_JUDGE_MODEL=qwen35

# Model the MCP and skill scanners use for their behavioral analyzers. Separate from the
# judge because the two jobs differ: one grades benchmark answers, the other reasons about
# code. One model call per source file, so a cheap or local model matters here.
SCANNER_MODEL=gemma4

# --- Real upstream provider keys ---------------------------------------------
# Consumed by the BUNDLED gateway only. The app never sees these, and no compute engine is
# ever configured with a provider-native key. Using your own gateway makes these irrelevant
# — that gateway holds its own credentials.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Local models -------------------------------------------------------------
# Where Ollama lives, for the bundled gateway's local routes. Host by default; the compose
# `local-models` profile overrides it.
OLLAMA_API_BASE=http://localhost:11434
